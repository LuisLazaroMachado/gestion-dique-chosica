# Copia este archivo como .env y rellena los valores (sin espacios después del =).
# Local (Docker): estos valores funcionan tal cual con infra/docker-compose.yml
DATABASE_URL=postgresql://dique:dique_local@localhost:5433/dique
# Almacenamiento de fotos: local (carpeta en disco) o s3 (Supabase Storage u otro compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/evidencias
S3_ENDPOINT=
S3_REGION=sa-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=evidencias
JWT_SECRET=cambia-esto-por-un-secreto-largo
CORS_ORIGIN=http://localhost:5173
# Ruteo (opcional): clave gratuita de openrouteservice.org
ORS_API_KEY=
# Nube (producción)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RENDER_API_KEY=
